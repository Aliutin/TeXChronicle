{
  "name": "texchronicle",
  "mcpName": "io.github.Aliutin/texchronicle",
  "version": "0.1.12",
  "description": "TeXChronicle — a universal LaTeX workspace with source-preserving visual editing, exact live PDF, anchored comments, and git-backed section history. Works directly or with MCP-compatible AI agents, with no local TeX install or Overleaf account required.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "texchronicle",
    "latex",
    "tex",
    "texlive",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "claude-code",
    "ai-agent",
    "ai-agents",
    "llm",
    "overleaf",
    "latex-editor",
    "wysiwyg-editor",
    "pdf",
    "preview",
    "wasm",
    "academic-writing",
    "research-tools"
  ],
  "homepage": "https://github.com/Aliutin/TeXChronicle#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aliutin/TeXChronicle.git"
  },
  "bugs": {
    "url": "https://github.com/Aliutin/TeXChronicle/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "texchronicle": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "scripts/build-ui.mjs",
    "src/",
    "ui/dist/",
    "assets/fallback-styles/",
    "docs/",
    ".mcp.json.example",
    "README.md",
    "NOTICE.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node --require ./bin/userInfoFallback.cjs --import tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p ui --noEmit",
    "build:ui": "node scripts/build-ui.mjs",
    "build:portable:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1",
    "verify:portable:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-portable.ps1",
    "dev:ui": "vite ui",
    "test": "node --require ./bin/userInfoFallback.cjs --import tsx --test test/*.test.ts",
    "postinstall": "node bin/ensureBrowser.mjs",
    "prepare": "npm run build:ui"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "chokidar": "^5.0.0",
    "diff": "^8.0.4",
    "diff2html": "^3.4.56",
    "katex": "^0.19.1",
    "open": "^11.0.4",
    "pdfjs-dist": "^6.5.438",
    "playwright": "^1.62.0",
    "texlyre-busytex": "^1.4.1",
    "tsx": "^4.23.15",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^6.0.4",
    "codemirror-lang-latex": "^0.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
